{
  "name": "vue-mobile-starter",
  "description": "Vue 3 移动端开发脚手架 - AI 驱动的工作流",
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run test:*)",
      "Bash(npm install:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(claude plugin:*)",
      "Bash(claude mcp:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "command": "npx eslint --fix {{file_path}}"
      }
    ],
    "PreCommit": [
      {
        "command": "npm run typecheck && npm run lint"
      }
    ]
  }
}
